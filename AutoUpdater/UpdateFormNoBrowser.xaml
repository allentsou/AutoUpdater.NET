<Window x:Class="AutoUpdater.UpdateFormNoBrowser"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AutoUpdater"
        xmlns:loc="clr-namespace:AutoUpdater.Localization"
        mc:Ignorable="d"
        Title="UpdateForm" Height="150" Width="600" ResizeMode="NoResize">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="130"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition></RowDefinition>
            <RowDefinition Height="50"></RowDefinition>
        </Grid.RowDefinitions>

        <Image Grid.Column="0" Grid.Row="0" Grid.RowSpan="2" VerticalAlignment="Top" Source="./update.png" Margin="0 10" Stretch="None" Name="leftSideIcon"  />

        <StackPanel Orientation="Vertical" Grid.Column="1" Grid.Row="0" Margin="5 5 5 5">
            <StackPanel.Resources>
                <Style TargetType="TextBlock">
                    <Setter Property="Margin">
                        <Setter.Value>
                            <Thickness Top="10"></Thickness>
                        </Setter.Value>
                    </Setter>
                </Style>
            </StackPanel.Resources>
            <TextBlock Text="新版 {0} 已經發行！" FontSize="16" FontWeight="Bold" Name="Title1"></TextBlock>
            <TextBlock Text=" {{0}} {{1}} 已經發行。本機目前的版本是 {2}。是否立即進行更新？" FontSize="14" Name="Title2"></TextBlock>
        </StackPanel>
        <StackPanel Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="忽略" FontSize="18" Width="140" Margin="0 0 80 0" Name="btnIgnore"></Button>
            <Button Content="更新" FontSize="18" Width="140" Margin="0 0 20 0" Name="btnUpdate"></Button>
        </StackPanel>
    </Grid>
</Window>
