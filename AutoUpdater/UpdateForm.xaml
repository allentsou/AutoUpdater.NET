<Window x:Class="AutoUpdater.UpdateForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AutoUpdater"
        xmlns:loc="clr-namespace:AutoUpdater.Localization"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        mc:Ignorable="d"
        Title="{x:Static loc:LocalizationResources.WindowTitle}" Height="840" Width="800" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Topmost="True" >
    <Grid>
        <Grid.RowDefinitions>
            <!-- 標題文字換行時自動長高，至少 100 -->
            <RowDefinition Height="Auto" MinHeight="100" x:Name="row1"></RowDefinition>
            <RowDefinition Height="*"  x:Name="row2"></RowDefinition>
            <RowDefinition Height="50" x:Name="row3"></RowDefinition>
        </Grid.RowDefinitions>
        <!-- 用 Grid 而不是水平 StackPanel：水平 StackPanel 給子項無限寬度，TextWrapping 不會換行 -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image Grid.Column="0" Source="./update.png"  Stretch="None" Name="AppIcon" Width="100" VerticalAlignment="Center" Margin="6" />
            <StackPanel Grid.Column="1" Orientation="Vertical" VerticalAlignment="Center" Margin="0 0 20 10">
                <StackPanel.Resources>
                    <Style TargetType="TextBlock">
                        <Setter Property="Margin">
                            <Setter.Value>
                                <Thickness Top="10"></Thickness>
                            </Setter.Value>
                        </Setter>
                        <Setter Property="TextWrapping" Value="Wrap" />
                    </Style>
                </StackPanel.Resources>
                <TextBlock Text="{x:Static loc:LocalizationResources.Title1}" FontSize="16" FontWeight="Bold" Name="Title1"></TextBlock>
                <TextBlock Text="{x:Static loc:LocalizationResources.Title2}" FontSize="14" Name="Title2"></TextBlock>
            </StackPanel>
        </Grid>
        
        <wv2:WebView2 x:Name="chgLogBrowser" Grid.Row="1" />

        <!-- 沒有 WebView2 Runtime 時，以此取代 WebView2 控制項顯示 -->
        <TextBlock x:Name="chgLogFallback" Grid.Row="1" Visibility="Collapsed" Margin="20" FontSize="14" TextWrapping="Wrap">
            <Hyperlink x:Name="chgLogLink" RequestNavigate="chgLogLink_RequestNavigate" />
        </TextBlock>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Grid.Row="2">
            <Button Content="{x:Static loc:LocalizationResources.ButtonIgnore}" FontSize="18" Width="140" Margin="0 0 80 0" Name="btnIgnore"></Button>
            <Button Content="{x:Static loc:LocalizationResources.ButtonUpdate}" FontSize="18" Width="140" Margin="0 0 20 0" Name="btnUpdate"></Button>
        </StackPanel>
    </Grid>


</Window>
