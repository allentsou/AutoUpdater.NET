<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0-windows7.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <Description>AutoUpdater For .Net Core WPF and WinForm applications</Description>
    <Copyright>鄒瑞成 2021</Copyright>
    <Version>1.2026.1117.2</Version>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageReleaseNotes>First Version</PackageReleaseNotes>
    <Authors>鄒瑞成 2021</Authors>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="update.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
    <PackageReference Include="NLog" Version="4.7.11" />
  </ItemGroup>

  <ItemGroup>
    <!-- 只用來決定建置順序：extractor 的 Release 建置會更新 Resources\AutoUpdater.ZipExtractor.zip，再由本專案內嵌。 -->
    <ProjectReference Include="..\AutoUpdater.ZipExtractor\AutoUpdater.ZipExtractor.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="update.png" />
  </ItemGroup>

  <ItemGroup>
    <!-- Publish 後自動部署到 FTP；放進 NuGet 套件的 build 與 buildTransitive，引用本套件的專案會自動匯入 -->
    <None Update="build\AutoUpdater.targets" Pack="true" PackagePath="build\AutoUpdater.targets;buildTransitive\AutoUpdater.targets" />
    <None Update="build\AutoUpdater.Deploy.ps1" Pack="true" PackagePath="build\AutoUpdater.Deploy.ps1;buildTransitive\AutoUpdater.Deploy.ps1" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Localization\LocalizationResources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>LocalizationResources.resx</DependentUpon>
    </Compile>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Localization\LocalizationResources.resx">
      <Generator>PublicResXFileCodeGenerator</Generator>
      <LastGenOutput>LocalizationResources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <!-- 語系資源直接內嵌在 AutoUpdater.dll，不產生 zh-TW\AutoUpdater.resources.dll 附屬組件，套件只需要一個 DLL。
         執行時由 EmbeddedCultureResourceManager 從主組件讀取。新增語系時照這個格式加一筆。 -->
    <EmbeddedResource Update="Localization\LocalizationResources.zh-TW.resx">
      <WithCulture>false</WithCulture>
      <LogicalName>AutoUpdater.Localization.LocalizationResources.zh-TW.resources</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Resources\" />
  </ItemGroup>

</Project>
