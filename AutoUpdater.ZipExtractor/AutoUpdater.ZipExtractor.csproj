<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net8.0-windows7.0</TargetFramework>
		<!--<TargetFrameworks>net48</TargetFrameworks>-->
		<UseWPF>true</UseWPF>
		<Version>1.2026.0715.2</Version>
		<PlatformTarget>AnyCPU</PlatformTarget>
		<DebugType>embedded</DebugType>
	</PropertyGroup>

	<ItemGroup>
		<None Remove="ZipExtractor.png" />
	</ItemGroup>

	<ItemGroup>
		<Resource Include="ZipExtractor.png" />
	</ItemGroup>

	<ItemGroup>
		<Compile Update="Localization\LocalizationResources.Designer.cs">
			<DesignTime>True</DesignTime>
			<AutoGen>True</AutoGen>
			<DependentUpon>LocalizationResources.resx</DependentUpon>
		</Compile>
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Update="Localization\LocalizationResources.resx">
			<Generator>PublicResXFileCodeGenerator</Generator>
			<LastGenOutput>LocalizationResources.Designer.cs</LastGenOutput>
		</EmbeddedResource>
	</ItemGroup>

	<ItemGroup>
		<None Update="AutoUpdaterConfig.json">
			<CopyToOutputDirectory>Never</CopyToOutputDirectory>
		</None>
		<None Update="RunILMerge.bat">
		  <CopyToOutputDirectory>Never</CopyToOutputDirectory>
		</None>
	</ItemGroup>

</Project>
