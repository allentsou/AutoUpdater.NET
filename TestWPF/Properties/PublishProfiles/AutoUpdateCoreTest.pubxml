<?xml version="1.0" encoding="utf-8"?>
<!--
  發行到 AutoUpdateCoreTest：Publish 完成後自動上傳更新包到 FTP 並更新 AutoUpdaterConfig.json。
  FTP 帳號密碼請設定在 Windows 使用者環境變數 AUTOUPDATER_FTP_USER、AUTOUPDATER_FTP_PASSWORD（設定後重新開啟 Visual Studio）。
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishDir>bin\Release\net8.0-windows7.0\publish\win-x64\</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
    <_TargetId>Folder</_TargetId>
    <TargetFramework>net8.0-windows7.0</TargetFramework>
    <SelfContained>false</SelfContained>
    <!-- 上傳更新包與設定檔的 FTP 資料夾 -->
    <AutoUpdaterFtpUrl>ftp://172.24.26.38/AutoUpdateCoreTest/</AutoUpdaterFtpUrl>
    <!-- 同一個資料夾在 IIS 上的 http 網址，用戶端從這裡下載更新包 -->
    <AutoUpdaterBaseUrl>http://172.24.26.38/Deploy/update/AutoUpdateCoreTest/</AutoUpdaterBaseUrl>
    <!-- 不放進更新包的檔案（分號分隔，相對於 publish 資料夾，可用萬用字元）。正式機的設定檔不同，不能被覆蓋 -->
    <AutoUpdaterExcludeFiles>TestWPF.dll.config</AutoUpdaterExcludeFiles>
    <!-- 和更新包一起上傳到 FTP 的其他檔案（分號分隔，相對於專案資料夾，可用萬用字元），例如更新說明頁 -->
    <AutoUpdaterUploadFiles>ChangeLog.html</AutoUpdaterUploadFiles>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
  </PropertyGroup>
</Project>