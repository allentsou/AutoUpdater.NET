<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" throwExceptions="true" internalLogFile="C:\temp\NLog_Internal.log" internalLogLevel="Warn">

  <targets>
    <!--Layout: https://github.com/NLog/NLog/wiki/Layout-Renderers -->
    <!--File target: https://github.com/NLog/NLog/wiki/File-target -->
    <!-- https://github.com/NLog/NLog/wiki/File-Target -->

    <target xsi:type="Debugger" name="DebugLog"
            layout="${date:format=HH\:mm\:ss} ${level} | ${message}${onexception:inner= ${newline}---------例外狀況開始---------${newline}${exception:format=ToString}${newline}---------例外狀況結束---------}"/>

    <default-target-parameters xsi:type="File" encoding="UTF-8" keepFileOpen="true"
                               openFileCacheTimeout="30" concurrentWrites="false" archiveNumbering="DateAndSequence"
                               archiveAboveSize="20000000" archiveEvery="Day" maxArchiveDays="60" archiveDateFormat="yyyyMMdd" AutoFlush="False" openFileFlushTimeout="1" />



    <target xsi:type="File" name="FileLog" fileName="${basedir}/Log/ZipExtractor.txt"
            layout="${date:format=yyyy/MM/dd HH\:mm\:ss} | ${level} -> ${message}${onexception:inner=${newline}---------例外狀況開始---------${newline}${exception:format=ToString}${newline}---------例外狀況結束---------}"
            archiveFileName="${basedir}/Log/ZipExtractor.{#}.txt" />


  </targets>
  <rules>
    <logger name="*" minlevel="Trace" writeTo="FileLog,DebugLog" />
  </rules>
</nlog>